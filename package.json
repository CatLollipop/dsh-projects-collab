{
  "name": "dsh-projects-collab",
  "version": "0.2.1-rc.2",
  "private": true,
  "type": "module",
  "description": "Durable Projects and Shared Projects collaboration for DeepSeek Harness.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./rpc": "./rpc.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["README.md", "index.js", "client.js", "rpc.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "test/*.test.js"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": { "node": ">=22", "dsh": ">=0.2.1-rc.2" },
  "scripts": { "test": "node --test" }
}
